<controls:ProWindow
    x:Class="ParcelsAddin.ConfigureAreaUnitsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
    xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
    mc:Ignorable="d"
    x:Name="ConfigureAreaUnitsInput"
    Title="Configure"
    SizeToContent="Height"
    MinWidth="300"
    Width="300"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

  <controls:ProWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary
                    Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </controls:ProWindow.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <!--<ColumnDefinition Width="170*" />
      <ColumnDefinition Width="130*" />
      <ColumnDefinition Width="30*" />-->
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="110" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Update stated area -->
    <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Orientation="Horizontal"
            Margin="20,3,0,0"
            HorizontalAlignment="Left">

      <CheckBox
                x:Name="chkUpdateStatedArea"
                Content="Update stated area"
                IsChecked="{Binding ConfigureAreaUnitsModel.UpdateStatedArea, UpdateSourceTrigger=PropertyChanged}"
                Background="{DynamicResource Esri_BackgroundHoverSelectedBrush}"
                Foreground="{DynamicResource Esri_TextControlBrush}"
                BorderBrush="{DynamicResource Esri_BorderHoverBrush}" />

    </StackPanel>
    <!-- Area unit -->
    <TextBlock
    Grid.Row="1"
    Grid.Column="0"
    Margin="0,3,10,3"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Text="Large parcel area unit"
    Style="{DynamicResource Esri_TextBlockRegular}" />
    <ComboBox
    Grid.Row="1"
    Grid.Column="1"
    Width="100"
    Height="22"
    HorizontalAlignment="Right"
    Margin="0,3,10,3"
    x:Name="LargeParcelAreaUnit"
    IsEditable="False"
    IsEnabled="{Binding ElementName=chkUpdateStatedArea, Path=IsChecked}"
    ItemsSource="{Binding ConfigureAreaUnitsModel.AreaUnitsNameList}"
    SelectedItem="{Binding ConfigureAreaUnitsModel.AreaUnitName}" />
    <!-- Area value -->
    <TextBlock
    Grid.Row="2"
    Grid.Column="0"
    Margin="0,3,10,0"
    HorizontalAlignment="Right"
    VerticalAlignment="Center"
    Text="Large parcel area"
    Style="{DynamicResource Esri_TextBlockRegular}" />
    <TextBox
    Grid.Row="2"
    Grid.Column="1"
    Margin="0,3,10,0"
    Width="100"
    Height="22"
    HorizontalAlignment="Right"
    TextAlignment="Right"
    x:Name="LargeParcelArea"
    IsEnabled="{Binding ElementName=chkUpdateStatedArea, Path=IsChecked}"
    Text="{Binding ConfigureAreaUnitsModel.LargeAreaValueText, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Grid.Row="3"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,15,0,10">
      <!-- OK Button -->
      <Button Content="OK"
            Width="60"
            Height="28"
            Margin="0,0,10,0"
            IsDefault="True"
            Command="{Binding OKCommand}"
            CommandParameter="{Binding ElementName=ConfigureAreaUnitsInput}"
            Style="{StaticResource Esri_SimpleButton}" />
      <!-- Cancel Button -->
      <Button Content="Cancel"
            Width="60"
            Height="28"
            Margin="0,0,10,0"  
            IsCancel="True"
            Style="{StaticResource Esri_SimpleButton}" />
    </StackPanel>
  </Grid>
</controls:ProWindow>